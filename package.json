{
  "name": "@sear/monorepo",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "agentic-workflow"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "biome format --write . && prettier --write .",
    "format:check": "biome format . && prettier --check .",
    "check": "turbo run lint typecheck test",
    "typecheck": "turbo run typecheck",
    "agentic-workflow": "yarn workspace @sear/agentic-workflow start",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "lefthook": "2.1.0",
    "prettier": "3.8.1",
    "turbo": "2.8.3",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24.13.0"
  }
}
